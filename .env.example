# Copy to .env and fill in local values. Never commit .env.

# Local Postgres from docker-compose.yml. Leave unset to use in-memory storage.
DATABASE_URL=postgresql+psycopg://releaseguard:releaseguard@localhost:5432/releaseguard

# Optional. Set both to pull commit and workflow data straight from GitHub.
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=owner/repo

# Not wired up yet.
# GROQ_API_KEY=
